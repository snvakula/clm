#!/opt/clm-client/venv/bin/python -B
"""Publish Nginx snippets for activated CLM certificates."""

import hashlib
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

from app.filesystem import sync_directory
from app.identity import normalise_identifier, storage_path

SNIPPETS = Path("/etc/nginx/snippets/clm")


def snippet_name(identifier: str) -> str:
    name = (
        f"_wildcard.{identifier[2:]}.conf" if identifier.startswith("*.") else f"{identifier}.conf"
    )
    if len(name) > 255:
        name = f"_sha256-{hashlib.sha256(identifier.encode('ascii')).hexdigest()}.conf"
    return name


def publish(destination: Path, content: bytes) -> None:
    descriptor, name = tempfile.mkstemp(prefix=".clm-", dir=destination.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            os.fchmod(stream.fileno(), 0o644)
            stream.flush()
            os.fsync(stream.fileno())
        # Link the complete file without replacing an operator's file.
        os.link(temporary, destination)
    finally:
        temporary.unlink()


def sync_snippets(root: Path, snippets: Path, identifiers: list[str], *, rollback: bool) -> None:
    if not root.is_absolute() or not re.fullmatch(r"[a-zA-Z0-9_./-]+", str(root)):
        raise ValueError("The CLM root is not an absolute path safe for Nginx")
    names = sorted({normalise_identifier(value) for value in identifiers})
    if not names:
        return
    if not rollback:
        snippets.mkdir(mode=0o755, parents=True, exist_ok=True)
    try:
        info = snippets.lstat()
    except FileNotFoundError:
        if rollback:
            return
        raise
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError(
            "The Nginx snippets directory must be owned by the hook user and protected"
        )

    for identifier in names:
        active = root.joinpath("certificates", *storage_path(identifier), "current")
        certificate = active / "fullchain.pem"
        key = active / "privkey.pem"
        content = (
            "# Managed by the CLM nginx-snippets hook.\n"
            f"ssl_certificate {certificate};\n"
            f"ssl_certificate_key {key};\n"
        ).encode("ascii")
        destination = snippets / snippet_name(identifier)
        try:
            published = destination.lstat()
        except FileNotFoundError:
            published = None
        if published is not None and (
            not stat.S_ISREG(published.st_mode)
            or published.st_uid != os.geteuid()
            or published.st_mode & 0o022
            or published.st_size != len(content)
            or destination.read_bytes() != content
        ):
            if rollback:
                continue
            raise ValueError(f"Refusing to overwrite the existing snippet {destination}")

        available = active.is_symlink() and certificate.is_file() and key.is_file()
        if rollback:
            if not available and published is not None:
                destination.unlink()
                sync_directory(snippets)
        elif not available:
            raise ValueError(f"Active certificate and key are unavailable for {identifier}")
        elif published is None:
            publish(destination, content)
            sync_directory(snippets)


def main() -> int:
    try:
        root = Path(os.environ["CLM_CLIENT_ROOT"])
        event = os.environ["CLM_HOOK_EVENT"]
        if event not in ("updated", "rollback"):
            raise ValueError("Unknown CLM hook event")
        identifiers = os.environ["CLM_UPDATED_CERTIFICATES"].splitlines()
        os.umask(0o022)
        sync_snippets(root, SNIPPETS, identifiers, rollback=event == "rollback")
    except (KeyError, OSError, ValueError) as error:
        print(f"nginx-snippets: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
