#!/opt/clm-client/venv/bin/python -B
"""Publish Nginx snippets for activated CLM certificates."""

import hashlib
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

from app.filesystem import sync_directory
from app.identity import normalise_identifier, storage_path

SNIPPETS = Path("/etc/nginx/snippets/clm")


def snippet_name(domain: str, name_max: int) -> str:
    name = f"{domain}.conf"
    if 0 < name_max < len(name):
        name = f"_sha256-{hashlib.sha256(domain.encode('ascii')).hexdigest()}.conf"
    return name


def publish(destination: Path, content: bytes, *, replace: bool) -> None:
    descriptor, name = tempfile.mkstemp(prefix=".clm-", dir=destination.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            os.fchmod(stream.fileno(), 0o644)
            stream.flush()
            os.fsync(stream.fileno())
        if replace:
            temporary.replace(destination)
        else:
            os.link(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def snippet_content(active: Path) -> bytes:
    return (
        "# Managed by the CLM nginx-snippets hook.\n"
        f"ssl_certificate {active / 'fullchain.pem'};\n"
        f"ssl_certificate_key {active / 'privkey.pem'};\n"
    ).encode("ascii")


def sync_snippets(root: Path, snippets: Path, identifiers: list[str], *, rollback: bool) -> None:
    if not root.is_absolute() or not re.fullmatch(r"[a-zA-Z0-9_./-]+", str(root)):
        raise ValueError("The CLM root is not an absolute path safe for Nginx")
    domains = sorted({normalise_identifier(value).removeprefix("*.") for value in identifiers})
    if not domains:
        return
    if not rollback:
        snippets.mkdir(mode=0o755, parents=True, exist_ok=True)
    try:
        info = snippets.lstat()
    except FileNotFoundError:
        if rollback:
            return
        raise
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError(
            "The Nginx snippets directory must be owned by the hook user and protected"
        )

    name_max = os.pathconf(snippets, "PC_NAME_MAX")
    for domain in domains:
        paths = [
            root.joinpath("certificates", *storage_path(identifier), "current")
            for identifier in (f"*.{domain}", domain)
        ]
        candidates = [(active, snippet_content(active)) for active in paths]
        contents = {content for _, content in candidates}
        selected = next(
            (
                content
                for active, content in candidates
                if active.is_symlink()
                and (active / "fullchain.pem").is_file()
                and (active / "privkey.pem").is_file()
            ),
            None,
        )
        destination = snippets / snippet_name(domain, name_max)
        existing = None
        try:
            published = destination.lstat()
        except FileNotFoundError:
            published = None
        if published is not None:
            if (
                stat.S_ISREG(published.st_mode)
                and published.st_uid == os.geteuid()
                and not published.st_mode & 0o022
                and published.st_size in {len(content) for content in contents}
            ):
                existing = destination.read_bytes()
            if existing not in contents:
                if rollback:
                    continue
                raise ValueError(f"Refusing to overwrite the existing snippet {destination}")

        if selected is None:
            if not rollback:
                raise ValueError(f"Active certificate and key are unavailable for {domain}")
            if existing is None:
                continue
            destination.unlink()
        elif selected != existing and (existing is not None or not rollback):
            publish(destination, selected, replace=existing is not None)
        else:
            continue
        sync_directory(snippets)


def main() -> int:
    try:
        root = Path(os.environ["CLM_CLIENT_ROOT"])
        event = os.environ["CLM_HOOK_EVENT"]
        if event not in ("updated", "rollback"):
            raise ValueError("Unknown CLM hook event")
        identifiers = os.environ["CLM_UPDATED_CERTIFICATES"].splitlines()
        os.umask(0o022)
        sync_snippets(root, SNIPPETS, identifiers, rollback=event == "rollback")
    except (KeyError, OSError, ValueError) as error:
        print(f"nginx-snippets: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
