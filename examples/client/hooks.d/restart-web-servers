#!/bin/sh
# Restart only web servers that the host service manager reports as running.
result=0
if command -v systemctl >/dev/null 2>&1 &&
    systemctl show --property=SystemState --value >/dev/null 2>&1; then
    for service in apache2.service httpd.service nginx.service; do
        systemctl is-active --quiet "$service"
        case $? in
            0)
                state=$(systemctl show --property=SubState --value "$service") || {
                    result=1
                    continue
                }
                if [ "$state" = running ]; then
                    systemctl try-restart "$service" || result=1
                fi
                ;;
            3|4) ;;
            *) result=1 ;;
        esac
    done
else
    if command -v rc-service >/dev/null 2>&1; then
        manager=rc-service
    elif command -v service >/dev/null 2>&1; then
        manager=service
    else
        exit 0
    fi
    for name in apache2 httpd nginx; do
        if "$manager" "$name" status >/dev/null 2>&1; then
            "$manager" "$name" restart || result=1
        fi
    done
fi
exit "$result"
