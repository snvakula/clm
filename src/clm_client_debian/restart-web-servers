#!/bin/sh
# Restart web server units that are present and running.
result=0
for service in apache2.service nginx.service; do
    systemctl is-active --quiet "$service"
    case $? in
        0)
            state=$(systemctl show --property=SubState --value "$service") || {
                result=1
                continue
            }
            if [ "$state" = running ]; then
                systemctl try-restart "$service" || result=1
            fi
            ;;
        3|4) ;;
        *) result=1 ;;
    esac
done
exit "$result"
